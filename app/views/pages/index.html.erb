<% content_for :title, "Welcome to E-Savero - Your Premium Shopping Destination" %>
<% content_for :meta_description, "Discover curated products that elevate your lifestyle. Shop our latest collections with free shipping on orders over $50." %>
<% content_for :body_class, "landing-page" %>

<div class="landing-page">
  <!-- Hero Section with Animated Gradient Background -->
  <section class="relative overflow-hidden bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 animate-gradient-x">
    <div class="absolute inset-0 bg-pattern opacity-10"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
            <span class="block">Discover What</span>
            <span class="block text-yellow-300">Defines Your Style</span>
          </h1>
          <p class="mt-6 text-xl md:text-2xl text-indigo-100 max-w-3xl">
            Curated collections that inspire. Quality products that last.
            Experience shopping reimagined.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="/products" class="rounded-md bg-white px-8 py-4 text-lg font-semibold text-indigo-600 shadow-md hover:bg-indigo-50 transition duration-300 ease-in-out transform hover:-translate-y-1">
              Shop Now
            </a>
            <a href="/categories" class="rounded-md border-2 border-white px-8 py-4 text-lg font-semibold text-white hover:bg-white hover:text-indigo-600 transition duration-300 ease-in-out transform hover:-translate-y-1">
              Explore Categories
            </a>
          </div>
          <div class="mt-12 flex items-center justify-center lg:justify-start space-x-6">
            <div class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="ml-2 text-white">Free Shipping</span>
            </div>
            <div class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span class="ml-2 text-white">Secure Checkout</span>
            </div>
            <div class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span class="ml-2 text-white">Easy Returns</span>
            </div>
          </div>
        </div>
        <div class="relative">
          <!-- Hero Image with Animation -->
          <div class="relative mx-auto w-full max-w-md md:max-w-lg shadow-2xl rounded-lg overflow-hidden transform transition-all hover:scale-105 duration-500">
            <%= image_tag "featured.png", alt:"Featured Collection", class:"w-full h-auto object-cover" %>
            <div class="absolute inset-0 bg-gradient-to-t from-indigo-900 via-transparent to-transparent opacity-70"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <span class="inline-block bg-yellow-400 text-indigo-900 px-3 py-1 rounded-full text-sm font-bold mb-3">NEW ARRIVAL</span>
              <h3 class="text-2xl font-bold">Summer Collection 2025</h3>
              <p class="mt-2">Limited edition pieces that define the season</p>
            </div>
          </div>

          <!-- Floating Elements -->
          <div class="absolute -top-10 -right-10 h-24 w-24 rounded-full bg-yellow-300 opacity-20 animate-pulse"></div>
          <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-pink-500 opacity-20 animate-pulse delay-300"></div>
        </div>
      </div>
    </div>

    <!-- Wave Divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" class="w-full h-auto text-white fill-current">
        <path d="M0,224L80,224C160,224,320,224,480,213.3C640,203,800,181,960,181.3C1120,181,1280,203,1360,213.3L1440,224L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
      </svg>
    </div>
  </section>

  <!-- Featured Categories Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Shop By Category</h2>
        <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">
          Explore our wide range of categories to find exactly what you're looking for
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Category Card 1 -->
        <div class="group relative overflow-hidden rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300">
          <div class="relative h-80 w-full overflow-hidden">
            <%=  image_tag  "fashion1.png", alt:"Fashion", class:"w-full h-full object-cover transition-all duration-500 group-hover:scale-110" %>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent opacity-80"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 transition-all duration-300 group-hover:pb-10">
            <h3 class="text-2xl font-bold text-white">Fashion</h3>
            <p class="mt-2 text-gray-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Discover the latest trends in clothing and accessories
            </p>
            <div class="mt-4">
              <a href="/categories/fashion" class="inline-flex items-center text-yellow-300 hover:text-yellow-400">
                Explore Collection
                <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Category Card 2 -->
        <div class="group relative overflow-hidden rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300">
          <div class="relative h-80 w-full overflow-hidden">
            <%= image_tag "electronics.png", alt:"Electronics", class:"w-full h-full object-cover transition-all duration-500 group-hover:scale-110" %>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent opacity-80"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 transition-all duration-300 group-hover:pb-10">
            <h3 class="text-2xl font-bold text-white">Electronics</h3>
            <p class="mt-2 text-gray-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Cutting-edge technology for your everyday needs
            </p>
            <div class="mt-4">
              <a href="/categories/electronics" class="inline-flex items-center text-yellow-300 hover:text-yellow-400">
                Explore Collection
                <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Category Card 3 -->
        <div class="group relative overflow-hidden rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300">
          <div class="relative h-80 w-full overflow-hidden">
            <%= image_tag "home-decor.png", alt:"Home Decor", class:"w-full h-full object-cover transition-all duration-500 group-hover:scale-110" %>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent opacity-80"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 transition-all duration-300 group-hover:pb-10">
            <h3 class="text-2xl font-bold text-white">Home Decor</h3>
            <p class="mt-2 text-gray-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Transform your space with our stunning home collection
            </p>
            <div class="mt-4">
              <a href="/categories/home-decor" class="inline-flex items-center text-yellow-300 hover:text-yellow-400">
                Explore Collection
                <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/categories" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition duration-300 ease-in-out transform hover:-translate-y-1">
