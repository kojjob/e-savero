<%# app/views/pages/about.html.erb %>
<% content_for :title, "About Us | E-Savero" %>
<% content_for :meta_description, "Learn about E-Savero, our mission, values, and the team behind our e-commerce platform." %>

<div class="bg-white dark:bg-gray-900">
  <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:py-20 lg:px-8">
    <div class="text-center">
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        About E-Savero
      </h1>
      <p class="mt-4 text-lg leading-6 text-gray-500 dark:text-gray-300">
        Your trusted destination for quality products since 2025.
      </p>
    </div>

    <div class="mt-12">
      <div class="prose prose-indigo mx-auto text-gray-500 dark:text-gray-300 dark:prose-invert">
        <h2>Our Story</h2>
        <p>
          Founded in 2025, ShopApp began with a simple mission: to create an online shopping experience that
          puts customer satisfaction first. What started as a small venture has grown into a comprehensive
          e-commerce platform serving customers worldwide.
        </p>

        <h2>Our Mission</h2>
        <p>
          At ShopApp, we believe that online shopping should be easy, secure, and enjoyable. Our mission is to
          provide a seamless shopping experience with a curated selection of high-quality products at fair prices.
        </p>

        <h2>Our Team</h2>
        <p>
          Behind ShopApp is a dedicated team of professionals passionate about e-commerce and customer service.
          From our developers to our customer support specialists, everyone at ShopApp is committed to making your
          shopping experience exceptional.
        </p>

        <div class="mt-10 grid gap-10 lg:grid-cols-3">
          <!-- Team Member 1 -->
          <div class="text-center">
            <div class="mx-auto h-40 w-40 rounded-full xl:w-44 xl:h-44 bg-indigo-100 flex items-center justify-center">
              <svg class="h-24 w-24 text-indigo-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 14.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" />
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 15a5 5 0 100-10 5 5 0 000 10z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="mt-3">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Jane Doe</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Founder & CEO</p>
            </div>
          </div>

          <!-- Team Member 2 -->
          <div class="text-center">
            <div class="mx-auto h-40 w-40 rounded-full xl:w-44 xl:h-44 bg-indigo-100 flex items-center justify-center">
              <svg class="h-24 w-24 text-indigo-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 14.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" />
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 15a5 5 0 100-10 5 5 0 000 10z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="mt-3">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">John Smith</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">CTO</p>
            </div>
          </div>

          <!-- Team Member 3 -->
          <div class="text-center">
            <div class="mx-auto h-40 w-40 rounded-full xl:w-44 xl:h-44 bg-indigo-100 flex items-center justify-center">
              <svg class="h-24 w-24 text-indigo-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 14.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" />
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 15a5 5 0 100-10 5 5 0 000 10z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="mt-3">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Sarah Johnson</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Head of Customer Experience</p>
            </div>
          </div>
        </div>

        <h2 class="mt-12">Our Values</h2>
        <ul>
          <li><strong>Quality:</strong> We carefully select each product in our catalog to ensure it meets our high standards.</li>
          <li><strong>Transparency:</strong> Clear pricing, honest descriptions, and no hidden fees.</li>
          <li><strong>Customer-First:</strong> Your satisfaction is our top priority. We're always here to help.</li>
          <li><strong>Security:</strong> Your personal and payment information is always protected.</li>
          <li><strong>Sustainability:</strong> We're committed to environmentally responsible practices.</li>
        </ul>

        <div class="mt-12 text-center">
          <h2>Get in Touch</h2>
          <p>Have questions or want to learn more about ShopApp?</p>
          <%= link_to "Contact Us", "/contact", class: "mt-4 inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
        </div>
      </div>
    </div>
  </div>
</div>