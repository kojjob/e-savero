<header class="bg-gradient-to-r from-indigo-800 via-purple-800 to-pink-500 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <div class="flex-shrink-0 flex items-center">
          <%= link_to root_path, class: "text-2xl font-bold text-white transition duration-300 hover:text-pink-200" do %>
            <div class="flex items-center space-x-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
              </svg>
              <span>E-Savero</span>
            </div>
          <% end %>
        </div>
        
        <nav class="hidden lg:ml-8 lg:flex lg:items-center lg:space-x-6">
          <%= link_to root_path, class: "px-3 py-2 rounded-md text-sm font-medium text-white hover:bg-white/20 transition duration-150 flex items-center space-x-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
            </svg>
            <span>Home</span>
          <% end %>
          
          <%= link_to products_path, class: "px-3 py-2 rounded-md text-sm font-medium text-white hover:bg-white/20 transition duration-150 flex items-center space-x-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
            </svg>
            <span>Shop</span>
          <% end %>
          
          <div class="relative" id="categories-dropdown" data-controller="header-dropdown" data-header-dropdown-placement-value="bottom-left" data-header-dropdown-close-on-click-outside-value="true" data-header-dropdown-close-on-escape-value="true" data-header-dropdown-close-on-selection-value="true" data-dropdown-interactions-target="dropdown">
            <button data-action="click->header-dropdown#toggle" class="px-3 py-2 rounded-md text-sm font-medium text-white hover:bg-white/20 transition duration-150 flex items-center space-x-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
              </svg>
              <span>Categories</span>
              <svg class="h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 011.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div data-header-dropdown-target="menu" class="hidden absolute w-56 rounded-md py-2 bg-white ring-1 ring-black/5 shadow-xl z-50 left-0 top-full mt-2 overflow-hidden">
              <div class="py-1">
                <% Category.order(:name).each do |category| %>
                  <%= link_to category_path(category), class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700 transition duration-150", data: { action: "header-dropdown#select" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-indigo-500" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
                    </svg>
                    <%= category.name %>
                  <% end %>
                <% end %>
              </div>
              <% if current_user&.admin? %>
                <div class="px-4 py-2 bg-gradient-to-r from-indigo-50 to-purple-50">
                  <%= link_to admin_categories_path, class: "flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800", data: { action: "header-dropdown#select" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M5 4a1 1 0 00-2 0v7.268a2 2 0 000 3.464V16a1 1 0 102 0v-1.268a2 2 0 000-3.464V4zM11 4a1 1 0 10-2 0v1.268a2 2 0 000 3.464V16a1 1 0 102 0V8.732a2 2 0 000-3.464V4zM16 3a1 1 0 011 1v7.268a2 2 0 010 3.464V16a1 1 0 11-2 0v-1.268a2 2 0 010-3.464V4a1 1 0 011-1z" />
                    </svg>
                    Manage Categories
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </nav>
      </div>
      
      <%= render "shared/mobile_nav" %>
      
      <div class="hidden lg:flex lg:items-center lg:space-x-4">
        <%= link_to my_cart_path, class: "p-2 rounded-full text-white hover:bg-white/20 transition duration-150 relative" do %>
          <div class="relative" style="isolation: isolate;">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="z-index: 1;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <% if user_signed_in? && current_user.cart.present? && current_user.cart.cart_items.count > 0 %>
              <span class="cart-badge absolute -top-2 -right-2 inline-flex items-center justify-center px-1.5 py-0.5 rounded-full text-xs font-bold leading-none bg-pink-500 text-white min-w-[18px] min-h-[18px]" style="z-index: 2;">
                <%= current_user.cart.cart_items.sum(:quantity) %>
              </span>
            <% end %>
          </div>
        <% end %>
        
        <div class="flex items-center" data-controller="dark-mode">
          <button type="button" class="p-2 rounded-full text-white hover:bg-white/20 transition duration-150" data-action="dark-mode#toggle">
            <!-- Sun icon (for dark mode) -->
            <svg data-dark-mode-target="sunIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon (for light mode) -->
            <svg data-dark-mode-target="moonIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
        
        <% if user_signed_in? %>
          <div class="relative ml-4" id="user-profile-dropdown" data-controller="header-dropdown" data-header-dropdown-placement-value="bottom-right" data-header-dropdown-close-on-click-outside-value="true" data-header-dropdown-close-on-escape-value="true" data-dropdown-interactions-target="dropdown" style="z-index: 3;">
            <button data-action="click->header-dropdown#toggle" class="flex items-center focus:outline-none" id="user-menu" aria-expanded="false">
              <span class="sr-only">Open user menu</span>
              <% if current_user.has_avatar? %>
                <div class="h-9 w-9 rounded-full bg-gradient-to-br from-pink-500 to-indigo-500 overflow-hidden">
                  <%= image_tag current_user.avatar_url, alt: "User avatar", class: "h-full w-full object-cover" %>
                </div>
              <% elsif current_user.first_name.present? && current_user.last_name.present? %>
                <div class="h-9 w-9 rounded-full bg-gradient-to-br from-pink-500 to-indigo-500 flex items-center justify-center text-white font-medium">
                  <%= current_user.first_name[0] %><%= current_user.last_name[0] %>
                </div>
              <% else %>
                <div class="h-9 w-9 rounded-full bg-gradient-to-br from-pink-500 to-indigo-500 flex items-center justify-center text-white font-medium">
                  <%= current_user.email[0].upcase %>
                </div>
              <% end %>
            </button>
            
            <div data-header-dropdown-target="menu" class="hidden absolute w-64 right-0 mt-2 rounded-lg bg-white shadow-2xl overflow-hidden" role="menu" style="z-index: 999;">
              <div class="bg-gradient-to-r from-indigo-800 to-purple-600 px-4 py-3 text-white">
                <p class="text-base font-medium">
                  <% if current_user.first_name.present? && current_user.last_name.present? %>
                    <%= "#{current_user.first_name} #{current_user.last_name}" %>
                  <% else %>
                    <%= current_user.email.split('@').first %>
                  <% end %>
                </p>
                <p class="text-sm text-white/80 truncate mt-0.5">
                  <%= current_user.email %>
                </p>
                <div class="mt-2 flex space-x-2">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
                    <%= current_user.admin? ? 'bg-pink-400 text-white' : 'bg-green-400 text-white' %>">
                    <%= current_user.role.capitalize %>
                  </span>
                  <% if current_user.status.present? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
                      <%= current_user.status == 'active' ? 'bg-green-400 text-white' : 'bg-gray-400 text-white' %>">
                      <%= current_user.status.capitalize %>
                    </span>
                  <% end %>
                </div>
              </div>
              
              <div class="py-1">
                <%= link_to edit_user_registration_path, class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 transition duration-150", role: "menuitem", data: { action: "header-dropdown#select" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  My Profile
                <% end %>
                
                <%= link_to orders_path, class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 transition duration-150", role: "menuitem", data: { action: "header-dropdown#select" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  My Orders
                <% end %>
                
                <%= link_to addresses_path, class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 transition duration-150", role: "menuitem", data: { action: "header-dropdown#select" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  My Addresses
                <% end %>
              </div>
              
              <% if current_user.admin? %>
                <div class="bg-gray-50 border-t border-gray-100">
                  <p class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">Admin</p>
                  <div class="py-1">
                    <%= link_to admin_root_path, class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 transition duration-150", role: "menuitem", data: { action: "header-dropdown#select" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      Dashboard
                    <% end %>
                    
                    <%= link_to admin_users_path, class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 transition duration-150", role: "menuitem", data: { action: "header-dropdown#select" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                      </svg>
                      Users
                    <% end %>
                    
                    <%= link_to admin_products_path, class: "flex px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 transition duration-150", role: "menuitem", data: { action: "header-dropdown#select" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                      </svg>
                      Products
                    <% end %>
                  </div>
                </div>
              <% end %>
              
              <div class="border-t border-gray-100">
                <div class="py-1">
                  <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition duration-150", role: "menuitem" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    Sign Out
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <div class="flex space-x-2">
            <%= link_to new_user_session_path, class: "px-4 py-2 rounded-md text-sm font-medium text-white bg-white/20 hover:bg-white/30 transition duration-150" do %>
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3 3a1 1 0 011 1v12a1 1 0 11-2 0V4a1 1 0 011-1zm7.707 3.293a1 1 0 010 1.414L9.414 9H17a1 1 0 110 2H9.414l1.293 1.293a1 1 0 01-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Sign In
              </div>
            <% end %>
            <%= link_to new_user_registration_path, class: "px-4 py-2 rounded-md text-sm font-medium text-white bg-pink-500 hover:bg-pink-600 transition duration-150" do %>
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z" />
                </svg>
                Sign Up
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>